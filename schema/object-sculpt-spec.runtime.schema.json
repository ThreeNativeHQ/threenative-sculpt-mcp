{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threenative.dev/schemas/object-sculpt-spec.runtime.schema.json",
  "title": "MCP runtime ObjectSculptSpec contract",
  "$comment": "img2threejs has no standalone ObjectSculptSpec JSON Schema. This runtime contract documents the subset consumed by threenative-sculpt-mcp; semantic depth thresholds are enforced in src/spec.ts.",
  "type": "object",
  "required": [
    "targetName",
    "suitability",
    "coordinateFrame",
    "silhouette",
    "componentTree",
    "materials",
    "proceduralStrategy",
    "preSpecAssessment",
    "qualityContract",
    "qualityTargets"
  ],
  "properties": {
    "schemaVersion": {
      "anyOf": [{ "type": "string" }, { "type": "number" }]
    },
    "targetName": { "type": "string", "minLength": 1 },
    "suitability": { "enum": ["pass", "conditional", "reject"] },
    "coordinateFrame": { "type": "object" },
    "silhouette": { "type": "object" },
    "componentTree": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "level": { "enum": ["macro", "meso", "micro"] },
          "localFeatures": { "type": "array" }
        }
      }
    },
    "materials": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "repetitionSystems": { "type": "array", "items": { "type": "object" } },
    "proceduralStrategy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "preSpecAssessment": {
      "type": "object",
      "required": ["complexity", "detailInventory"],
      "properties": {
        "complexity": {
          "type": "object",
          "required": ["tier"],
          "properties": {
            "tier": {
              "enum": ["simple", "moderate", "complex", "ultra-complex"]
            }
          }
        },
        "detailInventory": {
          "type": "object",
          "required": ["details"],
          "properties": {
            "details": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      }
    },
    "qualityContract": {
      "type": "object",
      "required": ["minimumSpecDepth"],
      "properties": {
        "minimumSpecDepth": {
          "type": "object",
          "required": [
            "macroComponents",
            "mesoComponents",
            "microFeatureGroups",
            "materialLayers",
            "repetitionSystems",
            "reviewViewpoints"
          ],
          "properties": {
            "macroComponents": { "type": "integer", "minimum": 0 },
            "mesoComponents": { "type": "integer", "minimum": 0 },
            "microFeatureGroups": { "type": "integer", "minimum": 0 },
            "materialLayers": { "type": "integer", "minimum": 0 },
            "repetitionSystems": { "type": "integer", "minimum": 0 },
            "reviewViewpoints": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "qualityTargets": {
      "type": "object",
      "required": ["reviewViewpoints"],
      "properties": {
        "reviewViewpoints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
